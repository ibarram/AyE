CC = gcc
001 = 01_Ejemplo
002 = 02_Ejemplo
003 = 03_Ejemplo
LIB = libarram
004 = 04_Ejemplo

all: $(001) $(002) $(003) $(004)

$(001): $(001).c
	$(CC) $(001).c -o $(001)

$(002): $(002).c
	$(CC) $(002).c -o $(002)

$(003): $(003).c
	$(CC) $(003).c -o $(003)

$(LIB).o: $(LIB).c
	$(CC) -c $(LIB).c -o $(LIB).o

lib$(LIB).lib: $(LIB).o
	ar rcs lib$(LIB).lib $(LIB).o

$(004):  $(004).c lib$(LIB).lib
	$(CC) $(004).c -L. -l$(LIB) -o $(004)

clean:
	rm -f $(001) $(002) $(003) $(004) $(005) $(006) $(LIB).o lib$(LIB).a $(007) $(008) $(009) $(010) $(011) $(012) $(013) $(014) $(015) $(016) $(017) $(018) $(019) $(020) $(021) $(022) $(023) $(024)